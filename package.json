  "bugs": {
    "url": "https://github.com/slonl/curriculum-rest-api/issues"
  },
  "homepage": "https://github.com/slonl/curriculum-rest-api#readme",
  "dependencies": {
    "@muze-nl/jsontag": "^0.10.4",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@muze-nl/jaqt": "^0.10.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tap": "^21.6.2"
  }
