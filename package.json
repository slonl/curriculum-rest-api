  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint --config .config/eslint.config.mjs",
    "start": "node src/api-server.js",
    "test": "tap test/*.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slonl/curriculum-rest-api.git"
  },
  "author": "",
